# Copy this file to .env.local and replace the dummy values.
# Real values live in Vercel → Settings → Environment Variables.
# Never commit .env.local or any file containing real credentials.

# ---------------------------------------------------------------------------
# Database — Postgres (Supabase or Neon).
# Use the pooled connection string (Supabase: Connect → Transaction pooler,
# port 6543) for the serverless runtime; keep the direct string (port 5432)
# for running db/schema.sql by hand.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/postgres?sslmode=require"

# ---------------------------------------------------------------------------
# Staff portal sessions — generate with: openssl rand -base64 32
# Must be at least 32 characters; the portal refuses to sign cookies otherwise.
# A different value per environment. Rotating it signs everyone out.
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-with-32-byte-random-string"
AUTH_URL="http://localhost:3000"

# No seed admin here: the first ADMIN account is created once, in the browser,
# at /admin/setup. It disables itself as soon as one user exists.

# ---------------------------------------------------------------------------
# Image storage — gallery rows store a URL, so uploads need somewhere to live.
# Pick one and delete the rest.
# ---------------------------------------------------------------------------
# Vercel Blob
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxx"
# Cloudinary (alternative)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Supabase Storage (alternative)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# Login rate limiting — no service needed. Failed attempts are counted in the
# login_attempts table: 5 failures per 15 minutes, per email and per IP.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Payment gateway — Midtrans (cards, QRIS, e-wallets, bank transfer).
# Create a sandbox account at https://midtrans.com, then copy the server key
# from Settings → Access Keys. The key never leaves Vercel and is never shown
# in the portal. Sandbox vs production and on/off are switched in
# Admin → System; MIDTRANS_IS_SANDBOX below is only the default for a fresh
# database (the stored setting wins once an admin saves it).
# Webhook URL to register in Midtrans: https://<your-domain>/api/payments/midtrans/webhook
# ---------------------------------------------------------------------------
MIDTRANS_SERVER_KEY=""
MIDTRANS_IS_SANDBOX=true

# ---------------------------------------------------------------------------
# Transactional email — Resend is used when RESEND_API_KEY is set, SendGrid is
# the fallback. The three outgoing identities are edited in Admin → System and
# the sender domains must be verified with the provider.
#   booking@telagawajarafting.com  — new bookings (internal + guest)
#   cancel@telagawajarafting.com   — cancellations
#   finance@telagawajarafting.com  — payments received
# Every attempt is written to the email_log table, including failures.
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
SENDGRID_API_KEY=""
SENDGRID_BOOKING_FROM="booking@telagawajarafting.com"
SENDGRID_CANCEL_FROM="cancel@telagawajarafting.com"
SENDGRID_FINANCE_FROM="finance@telagawajarafting.com"

# ---------------------------------------------------------------------------
# Public settings (safe to expose to the browser). Prefer the database for
# anything an admin edits.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="6281234567890"
