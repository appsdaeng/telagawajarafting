# Copy this file to .env.local and replace the dummy values.
# Real values live in Vercel → Settings → Environment Variables.
# Never commit .env.local or any file containing real credentials.

# ---------------------------------------------------------------------------
# Database — Postgres (Neon or Supabase). Use the pooled connection string
# for the serverless runtime, and the direct string for migrations.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/telagawajarafting?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/telagawajarafting?sslmode=require"

# ---------------------------------------------------------------------------
# Auth.js — generate with: openssl rand -base64 32
# A different value per environment. Rotating it signs everyone out.
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-with-32-byte-random-string"
AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Bootstrap admin — used once by the seed script to create the first admin.
# Leave empty in Production after the account exists.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-strong-temporary-password"
SEED_ADMIN_NAME="Admin"

# ---------------------------------------------------------------------------
# Image storage — pick one and delete the rest.
# ---------------------------------------------------------------------------
# Vercel Blob
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxx"
# Cloudinary (alternative)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Supabase Storage (alternative)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# Login rate limiting — Upstash Redis.
# In-memory counters do not work across serverless instances.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL="https://xxxxxxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN=""

# ---------------------------------------------------------------------------
# Public settings (safe to expose to the browser). Prefer the database
# SiteSetting table for anything an admin edits.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="6281234567890"
